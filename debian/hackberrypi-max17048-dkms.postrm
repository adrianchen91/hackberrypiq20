#!/bin/sh
# postrm for hackberrypi-max17048-dkms
#
#   postrm remove
#   postrm purge
#   old-postrm upgrade <new-version>
#   new-postrm failed-upgrade <old-version> <new-version>
#   new-postrm abort-install [<old-version>]
#   new-postrm abort-upgrade <old-version>
#   disappearer's-postrm disappear <overwriter> <overwriter-version>
#
# upgrade / failed-upgrade / abort-* / disappear: change NOTHING. The dtbo,
#   the config.txt block and the apt keyring/sources must survive upgrades.
# remove: take the managed block (and a legacy bare dtoverlay line) out of
#   config.txt first, then delete the dtbo. If config.txt still references
#   the overlay afterwards (a user-written line, or an edit that failed),
#   the dtbo is kept: config.txt must never point at a missing dtbo.
# purge: as remove, plus the apt keyring, the apt sources list and the
#   backups this package created.
# This script never fails (every fallible step is guarded).

set -e

PKG="hackberrypi-max17048-dkms"
OVL="hackberrypicm5"
BEGIN_MARK="# BEGIN hackberrypi (managed)"
END_MARK="# END hackberrypi"
# Parameter names of the overlay (__overrides__ in hackberrypicm5.dts).
OVL_PARAMS="hw_i2c touch_inv_x touch_inv_y touch_swap_xy no_touch no_fuelgauge fuelgauge_mainline charge_uah energy_uwh pclk i2c_delay_us"

# Path overrides are honoured only by the test harness, never in the
# packaged flow (a stray BOOT_DIR in root's environment must not matter).
if [ "${HACKBERRYPI_MAINTSCRIPT_TEST:-}" = "1" ]; then
    HB_BOOT_DIR="${BOOT_DIR:-/boot/firmware}"
    HB_KEYRING="${KEYRING:-/usr/share/keyrings/hackberrypi-max17048.gpg}"
    HB_SOURCES_LIST="${SOURCES_LIST:-/etc/apt/sources.list.d/hackberrypi-max17048.sources}"
    HB_STATE_DIR="${STATE_DIR:-/var/lib/hackberrypi-max17048-dkms}"
else
    HB_BOOT_DIR="/boot/firmware"
    HB_KEYRING="/usr/share/keyrings/hackberrypi-max17048.gpg"
    HB_SOURCES_LIST="/etc/apt/sources.list.d/hackberrypi-max17048.sources"
    HB_STATE_DIR="/var/lib/hackberrypi-max17048-dkms"
fi
HB_CONFIG="$HB_BOOT_DIR/config.txt"
HB_CONFIG_TMP="$HB_BOOT_DIR/config.txt.hackberrypi.tmp"
HB_CONFIG_BAK="$HB_BOOT_DIR/config.txt.hackberrypi.bak"
HB_CONFIG_ORIG="$HB_BOOT_DIR/config.txt.hackberrypi.orig"
HB_OVERLAY_DIR="$HB_BOOT_DIR/overlays"
HB_DTBO="$HB_OVERLAY_DIR/$OVL.dtbo"
HB_PREV="$HB_DTBO.prev"

say() { printf '%s: %s\n' "$PKG" "$*"; }
warn() { printf '%s: WARNING: %s\n' "$PKG" "$*" >&2; }

# Same parser as in postinst, byte-identical (the test harness checks).
# strip removes our block(s) with their dtparam lines, and legacy bare
# dtoverlay lines with the dtparam lines of ours that directly follow them.
HB_AWK='
function trim(s) { sub(/\r$/, "", s); sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function isuserref(t,   c) {
    if (index(t, ovlline) != 1 || length(t) == length(ovlline)) return 0
    c = substr(t, length(ovlline) + 1, 1)
    return (c == "," || c == ":" || c == "." || c == " " || c == "\t" || c == "#")
}
function ourkeys(t, all,   n, a, i, k, hit) {
    if (index(t, "dtparam=") != 1) return 0
    n = split(substr(t, 9), a, ","); hit = 0
    for (i = 1; i <= n; i++) {
        k = a[i]; sub(/=.*/, "", k)
        if (k in ours) hit++
        else if (all) return 0
    }
    return hit > 0
}
BEGIN {
    ovlline = "dtoverlay=" ovl
    np = split(params, pl, " "); for (i = 1; i <= np; i++) ours[pl[i]] = 1
    sall = 1; inc = 0; inblk = 0; nblk = 0; good = 0; bad = 0; legacy = 0; userref = 0
    pend = 0; follow = 0; orphans = 0; lsall = 0; linc = 1; other = 0
}
{
    raw = $0; t = trim(raw)
    if (t == bm) {
        if (inblk) bad = 1
        if (follow) { follow = 0; if (mode == "wrap") print em }
        inblk = 1; nblk++; bgood = 1; bovl = 0; ball = 0
        next
    }
    if (t == em) {
        if (!inblk) { bad = 1; if (mode == "strip" || mode == "wrap") print raw; next }
        inblk = 0
        if (bgood && bovl == 1) good++
        if (ball) pend = 1
        next
    }
    ishdr = 0
    if (substr(t, 1, 1) == "[" && index(t, "]") > 1) {
        ishdr = 1; f = tolower(substr(t, 2, index(t, "]") - 2)); sall = (f == "all"); inc = 0
    } else if (t ~ /^include([ \t]|$)/) {
        inc = 1
    }
    if (inblk) {
        if (t == ovlline) { bovl++; if (!sall || inc) bgood = 0 }
        else if (ishdr && f == "all") { ball = 1; if (bovl) bgood = 0 }
        else if (index(t, "dtparam=") == 1) { if (!bovl) bgood = 0; if (mode == "params") print raw }
        else if (substr(t, 1, 1) == "#") { if (mode == "params") print raw }
        else if (t != "") { bgood = 0; other++ }
        next
    }
    if (follow) {
        if (ourkeys(t, 1)) {
            if (mode == "params" || mode == "wrap") print raw
            next
        }
        follow = 0
        if (mode == "wrap") print em
    }
    if (t == ovlline) {
        legacy++; follow = 1
        if (legacy == 1) { lsall = sall; linc = inc }
        if (mode == "wrap") { print bm; print raw }
        next
    }
    if (isuserref(t)) userref++
    if (ourkeys(t, 0)) { orphans++; if (mode == "orphans") print "line " NR ": " t }
    if (pend && t != "" && substr(t, 1, 1) != "#") {
        if (!ishdr && mode == "strip") print "[all]"
        pend = 0
    }
    if (mode == "strip" || mode == "wrap") print raw
}
END {
    if (follow && mode == "wrap") print em
    if (inblk) bad = 1
    if (mode == "check")
        printf "bad=%d blocks=%d good=%d legacy=%d userref=%d endall=%d inplace=%d orphans=%d other=%d\n", bad, nblk, good, legacy, userref, (sall && !inc), (legacy == 1 && nblk == 0 && lsall && !linc), orphans, other
}'

hb_awk() { # hb_awk <mode> <file>
    awk -v mode="$1" -v ovl="$OVL" -v bm="$BEGIN_MARK" -v em="$END_MARK" -v params="$OVL_PARAMS" "$HB_AWK" "$2"
}
cfg_check() { hb_awk check "$1"; }
cfg_strip() { hb_awk strip "$1"; }
cfg_field() {
    hb_v="$(printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -n 1)"
    printf '%s\n' "${hb_v:-0}"
}

safe_copy() {
    cp -p "$1" "$2.tmp" || { rm -f "$2.tmp"; return 1; }
    sync
    mv -f "$2.tmp" "$2" || { rm -f "$2.tmp"; return 1; }
    return 0
}

# Remove our block and legacy lines from config.txt.
# Returns 0 if config.txt no longer references the overlay at all (so the
# dtbo may be deleted), 1 otherwise.
unconfigure() {
    if [ ! -f "$HB_CONFIG" ]; then
        return 0
    fi
    hb_facts="$(cfg_check "$HB_CONFIG")" || { warn "could not parse $HB_CONFIG"; return 1; }
    if [ "$(cfg_field "$hb_facts" bad)" != 0 ]; then
        warn "unbalanced '$BEGIN_MARK' / '$END_MARK' markers in $HB_CONFIG; not editing it"
        return 1
    fi
    if [ "$(cfg_field "$hb_facts" other)" != 0 ]; then
        warn "the '$BEGIN_MARK' block in $HB_CONFIG contains lines this package did not"
        warn "write; not editing config.txt so they are not lost (remove the block by hand)"
        return 1
    fi
    if [ "$(cfg_field "$hb_facts" blocks)" != 0 ] || [ "$(cfg_field "$hb_facts" legacy)" != 0 ]; then
        if ! cfg_strip "$HB_CONFIG" > "$HB_CONFIG_TMP"; then
            rm -f "$HB_CONFIG_TMP"
            warn "could not write $HB_CONFIG_TMP; $HB_CONFIG left unchanged"
            return 1
        fi
        hb_nfacts="$(cfg_check "$HB_CONFIG_TMP")" || hb_nfacts="bad=1"
        if [ "$(cfg_field "$hb_nfacts" bad)" != 0 ] || [ "$(cfg_field "$hb_nfacts" blocks)" != 0 ] ||
            [ "$(cfg_field "$hb_nfacts" legacy)" != 0 ]; then
            rm -f "$HB_CONFIG_TMP"
            warn "internal error: stripped config.txt failed verification; left unchanged"
            return 1
        fi
        if [ ! -e "$HB_CONFIG_ORIG" ]; then
            safe_copy "$HB_CONFIG" "$HB_CONFIG_ORIG" || true
        fi
        if ! safe_copy "$HB_CONFIG" "$HB_CONFIG_BAK"; then
            rm -f "$HB_CONFIG_TMP"
            warn "could not back up $HB_CONFIG; left unchanged"
            return 1
        fi
        sync
        if ! mv -f "$HB_CONFIG_TMP" "$HB_CONFIG"; then
            rm -f "$HB_CONFIG_TMP"
            warn "could not replace $HB_CONFIG; left unchanged"
            return 1
        fi
        sync
        say "removed $OVL from $HB_CONFIG"
        hb_facts="$hb_nfacts"
    fi
    if [ "$(cfg_field "$hb_facts" userref)" != 0 ]; then
        warn "$HB_CONFIG still loads $OVL on a line this package did not write;"
        warn "keeping $HB_DTBO so that line does not point at a missing file"
        return 1
    fi
    return 0
}

remove_overlay() {
    if [ ! -d "$HB_BOOT_DIR" ] || [ ! -d "$HB_OVERLAY_DIR" ]; then
        warn "$HB_OVERLAY_DIR not found (boot partition not mounted?)."
        warn "If it is mounted later, remove the '$BEGIN_MARK' block from config.txt"
        warn "first, then $HB_DTBO."
        return 1
    fi
    if unconfigure; then
        rm -f "$HB_DTBO.tmp"
        if [ -e "$HB_DTBO" ]; then
            if rm -f "$HB_DTBO"; then
                sync
                say "removed $HB_DTBO"
            else
                warn "could not remove $HB_DTBO (harmless: nothing references it)"
            fi
        fi
        return 0
    fi
    warn "config.txt may still reference $OVL; the overlay file was kept."
    return 1
}

case "$1" in
    remove)
        remove_overlay || true
        ;;
    purge)
        if remove_overlay; then
            rm -f "$HB_PREV" "$HB_CONFIG_BAK" "$HB_CONFIG_ORIG" 2>/dev/null || true
        fi
        rm -f "$HB_KEYRING" "$HB_SOURCES_LIST" 2>/dev/null || true
        rm -f "$HB_STATE_DIR/keyring" "$HB_STATE_DIR/sources" "$HB_STATE_DIR/overlay-enabled" \
            "$HB_STATE_DIR/config.pre" 2>/dev/null || true
        rmdir "$HB_STATE_DIR" 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Deliberately nothing: see the header.
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
